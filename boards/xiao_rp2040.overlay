/ {
  chosen {
    zephyr,console = &usb_cdc_acm_uart;
    zephyr,shell-uart = &usb_cdc_acm_uart;
  };

  aliases {
    mycan = &can;
    strip = &strip;
    watchdog = &wdt0;
  };
};

&usbd {
  usb_cdc_acm_uart: cdc-acm-uart {
    compatible = "zephyr,cdc-acm-uart";
    status = "okay";
  };
  // for mcumanager
  usb_cdc_acm_uart2: cdc-acm-uart2 {
    compatible = "zephyr,cdc-acm-uart";
    status = "okay";
  };
};

&pinctrl {
  ws2812_2_pio0_default: ws2812_2_pio0_default {
    ws2812_2 {
      pinmux = <PIO0_P27>;
    };
  };
};

&adc {
  status = "disabled";
};

&pio0 {
  status = "okay";
  pio-ws2812-2 {
    compatible = "worldsemi,ws2812-rpi_pico-pio";
    status = "okay";
    pinctrl-0 = <&ws2812_2_pio0_default>;
    pinctrl-names = "default";
    bit-waveform = <3>, <3>, <4>;

    strip: strip {
      status = "okay";
      gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
      chain-length = <20>;
      color-mapping = <LED_COLOR_ID_GREEN
                       LED_COLOR_ID_RED
                       LED_COLOR_ID_BLUE>;
      frequency = <800000>;
    };
  };
};

&spi0 {
  status = "okay";
  cs-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;
  can: can@0 {
    status = "okay";
    compatible = "microchip,mcp2515";
    reg = <0>;
    spi-max-frequency = <1000000>;
    osc-freq = <16000000>;
    int-gpios = <&xiao_d 0 GPIO_ACTIVE_LOW>;
		can-transceiver {
			max-bitrate = <1000000>;
		};
  };
};

&wdt0 {
  status = "okay";
};
